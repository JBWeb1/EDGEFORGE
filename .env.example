# PostgreSQL connection string
DATABASE_URL="postgresql://edgeforge:edgeforge@localhost:5432/edgeforge?schema=public"

# Better Auth: generate with `openssl rand -base64 32`. Required in production.
BETTER_AUTH_SECRET=""
# Public URL of the app
BETTER_AUTH_URL="http://localhost:3000"

# Optional: live stock and forex prices for open trades (https://finnhub.io).
# Crypto prices (e.g. BTCUSDT) work without a key.
FINNHUB_API_KEY=""

# Optional: AI trading coach (Claude API). Without it the coach page explains how to enable it.
ANTHROPIC_API_KEY=""
# Questions per user per day (default 30)
COACH_DAILY_LIMIT="30"
